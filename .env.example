# OAuthPath Configuration
# Copy to .env and fill in your values. Never commit .env.

# LLM provider: 'gemini' (default, free tier) or 'anthropic'
LLM_PROVIDER=gemini

# Google AI Studio (Gemini) - required if LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Tavily - required if LLM_PROVIDER=gemini for web search & extraction
TAVILY_API_KEY=your-tavily-api-key-here

# Anthropic - required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
RESEARCH_MODEL=claude-sonnet-5-5

# Optional: enables Composio toolkit lookup
COMPOSIO_API_KEY=your-composio-api-key-here

# Setup attempt credentials (for scripts/composio_test.py)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Database
DATABASE_PATH=./data/oauthpath.db

# Job settings
JOB_TIMEOUT_SECONDS=420
MAX_CONCURRENT_JOBS=1
MAX_SEARCHES=6
MAX_FETCHES=8
MAX_FETCH_TOKENS=10000
MAX_TURNS=8
JOBS_PER_IP_PER_HOUR=5
CACHE_MAX_AGE_HOURS=168

# Proxy / network configuration
# Set to "*" for PaaS deployments (Render/Railway), or restrict to trusted proxy IPs (e.g. "127.0.0.1")
FORWARDED_ALLOW_IPS=*

# Public URL for share links
PUBLIC_BASE_URL=http://localhost:8000
